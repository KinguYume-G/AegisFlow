# AegisFlow configuration template — placeholders only

APP_ENV=<development|test|production>
APP_BASE_URL=<APP_BASE_URL>
CORE_HOST_PORT=<CORE_HOST_PORT>
API_BASE_URL=<API_BASE_URL>
SANDBOX_BROKER_URL=http://sandbox-broker:8081
SANDBOX_DEFAULT_TIMEOUT_SECONDS=120
SANDBOX_DEFAULT_MEMORY_LIMIT_MB=512
SANDBOX_DEFAULT_CPU_LIMIT=1
SANDBOX_DEFAULT_PIDS_LIMIT=128
DOCKER_SOCKET_GID=0

DATABASE_URL=postgresql+asyncpg://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
LANGGRAPH_DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
POSTGRES_USER=<POSTGRES_USER>
POSTGRES_PASSWORD=<POSTGRES_PASSWORD>
POSTGRES_DB=<POSTGRES_DB>
POSTGRES_HOST_PORT=<POSTGRES_HOST_PORT>
REDIS_URL=redis://:<REDIS_PASSWORD>@<REDIS_HOST>:<REDIS_PORT>/<REDIS_DB>
REDIS_HOST_PORT=<REDIS_HOST_PORT>

# Local MVP profile. Keep disabled outside the loopback-only development stack.
# Prefer `.env.local-mvp.example` when running the complete local demo.
LOCAL_MVP_PROFILE_ENABLED=false
LOCAL_MVP_DEVELOPER_TOKEN=<LOCAL_ONLY_DEVELOPER_TOKEN_MIN_16_CHARS>
LOCAL_MVP_REVIEWER_TOKEN=<LOCAL_ONLY_REVIEWER_TOKEN_MIN_16_CHARS>
LOCAL_MVP_TENANT_SLUG=local-mvp
LOCAL_MVP_WORKSPACE_ROOT=<ABSOLUTE_SANDBOX_WORKSPACE_ROOT>
LOCAL_MVP_GITHUB_DRY_RUN=true
CONSOLE_HOST_PORT=3000
REVIEWER_CONSOLE_HOST_PORT=3001

TEMPORAL_ADDRESS=<TEMPORAL_HOST>:<TEMPORAL_PORT>
TEMPORAL_NAMESPACE=<TEMPORAL_NAMESPACE>
TEMPORAL_TASK_QUEUE=<TEMPORAL_TASK_QUEUE>

OIDC_ISSUER=<HTTPS_OIDC_ISSUER>
OIDC_AUDIENCE=<OIDC_AUDIENCE_OR_CLIENT_ID>
OIDC_JWKS_URL=<HTTPS_OIDC_JWKS_URL>
OIDC_ALGORITHM=RS256
OIDC_CACHE_TTL_SECONDS=300
OIDC_MAX_CACHED_KEYS=16
OIDC_HTTP_TIMEOUT_SECONDS=5

GITHUB_APP_ID=<GITHUB_APP_ID>
GITHUB_APP_PRIVATE_KEY=<GITHUB_APP_PRIVATE_KEY_REFERENCE>
GITHUB_APP_WEBHOOK_SECRET=<GITHUB_APP_WEBHOOK_SECRET>
GITHUB_APP_INSTALLATION_ID=<GITHUB_APP_INSTALLATION_ID>
GITHUB_API_TIMEOUT_SECONDS=10

MODEL_PRIMARY_NAME=<provider/primary-model>
MODEL_PRIMARY_API_KEY_ENV=<PRIMARY_PROVIDER_SECRET_ENV_NAME>
MODEL_FALLBACK_NAME=<provider/fallback-model>
MODEL_FALLBACK_API_KEY_ENV=<FALLBACK_PROVIDER_SECRET_ENV_NAME>
# Optional non-production vLLM route; disabled unless explicitly set to true.
MODEL_LOCAL_FALLBACK_ENABLED=false
MODEL_LOCAL_FALLBACK_NAME=openai/Qwen/Qwen3-0.6B
MODEL_LOCAL_FALLBACK_API_KEY_ENV=<VLLM_API_KEY_ENV_NAME>
MODEL_LOCAL_FALLBACK_BASE_URL=http://127.0.0.1:8000/v1
# Local MVP Ollama route; independent from the optional vLLM fallback.
MODEL_OLLAMA_ENABLED=false
MODEL_OLLAMA_NAME=qwen3:8b
MODEL_OLLAMA_API_KEY_ENV=OLLAMA_API_KEY
MODEL_OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_API_KEY=<LOCAL_OLLAMA_PLACEHOLDER_NOT_A_PRODUCTION_SECRET>
# Define the referenced Secret variables only in a local secret store or protected GitHub Environment.

# Next.js Console BFF. The local token/profile is not a production identity system.
AEGISFLOW_CORE_URL=http://core:8000
AEGISFLOW_CONSOLE_PERSONA=<developer|reviewer>
AEGISFLOW_LOCAL_TOKEN=<MATCHING_LOCAL_MVP_TOKEN>
AEGISFLOW_DEVELOPER_CONSOLE_URL=http://localhost:3000
AEGISFLOW_REVIEWER_CONSOLE_URL=http://localhost:3001

LANGFUSE_BASE_URL=<LANGFUSE_BASE_URL>
LANGFUSE_PUBLIC_KEY=<LANGFUSE_PUBLIC_KEY>
LANGFUSE_SECRET_KEY=<LANGFUSE_SECRET_KEY>
LANGFUSE_TRACING_ENVIRONMENT=<LANGFUSE_TRACING_ENVIRONMENT>

OTEL_EXPORTER_OTLP_ENDPOINT=<OTEL_EXPORTER_OTLP_ENDPOINT>
PROMETHEUS_ENDPOINT=<PROMETHEUS_ENDPOINT>
GRAFANA_URL=<GRAFANA_URL>

SANDBOX_RUNTIME=<docker|kubernetes>
SANDBOX_NETWORK_POLICY=<disabled|allowlist>
SANDBOX_ALLOWED_HOSTS=<COMMA_SEPARATED_ALLOWLIST>

ENCRYPTION_KEY_REFERENCE=<SECRET_MANAGER_REFERENCE>
