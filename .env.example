# AegisFlow configuration template — placeholders only

APP_ENV=<development|test|production>
APP_BASE_URL=<APP_BASE_URL>
CORE_HOST_PORT=<CORE_HOST_PORT>
API_BASE_URL=<API_BASE_URL>
SANDBOX_BROKER_URL=http://sandbox-broker:8081
SANDBOX_DEFAULT_TIMEOUT_SECONDS=120
SANDBOX_DEFAULT_MEMORY_LIMIT_MB=512
SANDBOX_DEFAULT_CPU_LIMIT=1
SANDBOX_DEFAULT_PIDS_LIMIT=128

DATABASE_URL=postgresql+asyncpg://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
POSTGRES_USER=<POSTGRES_USER>
POSTGRES_PASSWORD=<POSTGRES_PASSWORD>
POSTGRES_DB=<POSTGRES_DB>
POSTGRES_HOST_PORT=<POSTGRES_HOST_PORT>
REDIS_URL=redis://:<REDIS_PASSWORD>@<REDIS_HOST>:<REDIS_PORT>/<REDIS_DB>
REDIS_HOST_PORT=<REDIS_HOST_PORT>

TEMPORAL_ADDRESS=<TEMPORAL_HOST>:<TEMPORAL_PORT>
TEMPORAL_NAMESPACE=<TEMPORAL_NAMESPACE>
TEMPORAL_TASK_QUEUE=<TEMPORAL_TASK_QUEUE>

OIDC_ISSUER_URL=<OIDC_ISSUER_URL>
OIDC_CLIENT_ID=<OIDC_CLIENT_ID>
OIDC_CLIENT_SECRET=<OIDC_CLIENT_SECRET>
OIDC_REDIRECT_URI=<OIDC_REDIRECT_URI>

GITHUB_APP_ID=<GITHUB_APP_ID>
GITHUB_APP_PRIVATE_KEY=<GITHUB_APP_PRIVATE_KEY_REFERENCE>
GITHUB_WEBHOOK_SECRET=<GITHUB_WEBHOOK_SECRET>
GITHUB_INSTALLATION_ID=<GITHUB_INSTALLATION_ID>
GITHUB_API_TIMEOUT_SECONDS=10

LITELLM_BASE_URL=<LITELLM_BASE_URL>
PRIMARY_MODEL=<PRIMARY_MODEL>
FALLBACK_MODEL=<FALLBACK_MODEL>
MODEL_PROVIDER_API_KEY=<MODEL_PROVIDER_API_KEY>

LANGFUSE_BASE_URL=<LANGFUSE_BASE_URL>
LANGFUSE_PUBLIC_KEY=<LANGFUSE_PUBLIC_KEY>
LANGFUSE_SECRET_KEY=<LANGFUSE_SECRET_KEY>
LANGFUSE_TRACING_ENVIRONMENT=<LANGFUSE_TRACING_ENVIRONMENT>

OTEL_EXPORTER_OTLP_ENDPOINT=<OTEL_EXPORTER_OTLP_ENDPOINT>
PROMETHEUS_ENDPOINT=<PROMETHEUS_ENDPOINT>
GRAFANA_URL=<GRAFANA_URL>

SANDBOX_RUNTIME=<docker|kubernetes>
SANDBOX_NETWORK_POLICY=<disabled|allowlist>
SANDBOX_ALLOWED_HOSTS=<COMMA_SEPARATED_ALLOWLIST>

ENCRYPTION_KEY_REFERENCE=<SECRET_MANAGER_REFERENCE>
