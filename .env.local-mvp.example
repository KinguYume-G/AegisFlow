# Local MVP only. Copy to `.env.local-mvp` and change the local-only values.
# Never reuse these placeholders or this profile in production.

APP_ENV=development
APP_BASE_URL=http://127.0.0.1:8000

POSTGRES_USER=aegisflow_local
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=aegisflow_local
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379
TEMPORAL_HOST_PORT=57233
CORE_HOST_PORT=8000
CONSOLE_HOST_PORT=3000
REVIEWER_CONSOLE_HOST_PORT=3001

LOCAL_MVP_DEVELOPER_TOKEN=change-me-local-developer-token
LOCAL_MVP_REVIEWER_TOKEN=change-me-local-reviewer-token
LOCAL_MVP_TENANT_SLUG=local-mvp

OLLAMA_MODEL=qwen3:8b
OLLAMA_API_KEY=ollama-local-placeholder

# On Linux, set this to the host Docker socket group ID when required.
DOCKER_SOCKET_GID=0
