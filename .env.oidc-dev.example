# Development-only OIDC profile. Copy to an ignored `.env.oidc-dev` and replace
# every placeholder. Never reuse these values or this Keycloak start-dev profile
# in production.

APP_ENV=development
POSTGRES_USER=aegisflow_oidc_local
POSTGRES_PASSWORD=<GENERATE_LOCAL_DATABASE_PASSWORD>
POSTGRES_DB=aegisflow_oidc_local
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379
TEMPORAL_HOST_PORT=57233
CORE_HOST_PORT=8000
CONSOLE_HOST_PORT=3000
KEYCLOAK_HOST_PORT=8080
DOCKER_SOCKET_GID=0

KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=local-keycloak-admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=<GENERATE_LOCAL_KEYCLOAK_BOOTSTRAP_PASSWORD>
AEGISFLOW_KEYCLOAK_CLIENT_SECRET=<GENERATE_LOCAL_OIDC_CLIENT_SECRET_MIN_16_CHARS>
AEGISFLOW_KEYCLOAK_DEVELOPER_PASSWORD=<GENERATE_LOCAL_DEVELOPER_PASSWORD>
AEGISFLOW_KEYCLOAK_REVIEWER_PASSWORD=<GENERATE_LOCAL_REVIEWER_PASSWORD>
AEGISFLOW_KEYCLOAK_ADMIN_PASSWORD=<GENERATE_LOCAL_ADMIN_PASSWORD>

# Generate exactly 32 random bytes and encode with base64url without padding.
AEGISFLOW_SESSION_ENCRYPTION_KEY=<BASE64URL_32_BYTE_KEY>
